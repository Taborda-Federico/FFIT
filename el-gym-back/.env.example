# Copiá este archivo a .env y completá los valores reales. NUNCA commitees el .env.
PORT=5000
# Usuario y clave propios de Atlas, con una clave larga y única.
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/<base>
# Cadena larga y aleatoria (32+ caracteres). Rotarla desloguea a todos.
JWT_SECRET=<cadena-larga-aleatoria>
EMAIL_USER=<casilla-que-envia-los-mails>
EMAIL_PASS=<clave-de-aplicacion-del-mail>
ADMIN_REGISTRATION_SECRET=<secreto-para-registrar-admins>
